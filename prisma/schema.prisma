generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String
  role     String @default("USER")

  ownedCopies   BookCopy[]     @relation("BookOwner")
  borrowedLoans Loan[]         @relation("BorrowerLoans")
  ownedLoans    Loan[]         @relation("OwnerLoans")
  notifications Notification[]
  reservations  Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Book {
  id              String  @id @default(cuid())
  title           String
  type            String
  synopsis        String?
  edition         String?
  publicationYear Int?
  publisher       String?
  author          String?
  genre           String
  imageUrl        String?

  copies BookCopy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BookCopy {
  id        String @id @default(cuid())
  bookId    String
  ownerId   String
  code      String @unique
  status    String @default("AVAILABLE")
  condition String?

  book  Book @relation(fields: [bookId], references: [id])
  owner User @relation("BookOwner", fields: [ownerId], references: [id])

  loans        Loan[]
  history      LoanHistory[]
  reservations Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Loan {
  id         String    @id @default(cuid())
  bookCopyId String
  borrowerId String
  ownerId    String
  loanDate   DateTime  @default(now())
  dueDate    DateTime
  returnDate DateTime?
  status     String    @default("ACTIVE")

  bookCopy BookCopy @relation(fields: [bookCopyId], references: [id])
  borrower User     @relation("BorrowerLoans", fields: [borrowerId], references: [id])
  owner    User     @relation("OwnerLoans", fields: [ownerId], references: [id])

  history       LoanHistory[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoanHistory {
  id         String  @id @default(cuid())
  loanId     String
  bookCopyId String
  fromUserId String?
  toUserId   String?
  action     String
  notes      String?

  loan     Loan     @relation(fields: [loanId], references: [id])
  bookCopy BookCopy @relation(fields: [bookCopyId], references: [id])

  createdAt DateTime @default(now())
}

model Notification {
  id           String    @id @default(cuid())
  loanId       String
  userId       String
  type         String
  subject      String
  message      String
  scheduledFor DateTime
  sentAt       DateTime?
  status       String    @default("PENDING")

  loan Loan @relation(fields: [loanId], references: [id])
  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model Reservation {
  id         String @id @default(cuid())
  bookCopyId String
  userId     String
  status     String @default("ACTIVE")
  notes      String?

  bookCopy BookCopy @relation(fields: [bookCopyId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}